# Vorlage für .env – echte Werte NICHT ins Repository einchecken!

APP_PORT=8080
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:HIER_EIGENEN_SCHLUESSEL_EINTRAGEN
APP_URL=http://192.0.2.10:8080
APP_TIMEZONE=Europe/Berlin
APP_LOCALE=de-DE

DB_CONNECTION=mysql
DB_HOST=snipeit-db
DB_PORT=3306
DB_DATABASE=snipeit
DB_USERNAME=snipeit
DB_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

MAIL_MAILER=log
MAIL_FROM_ADDR=snipeit@example.local
MAIL_FROM_NAME="Snipe-IT Labor"
